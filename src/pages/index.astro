---
import '../styles/site.css';
import { profile, previews, publications, projects, cv, music, notes, withPreviews } from '../data/load';

const icons = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const icon = (name: string) => icons[`../icons/${name}.svg`] ?? '';
const isMail = (url: string) => url.startsWith('mailto:');

const TOPICS = [
  { id: 'tabular', label: 'Tabular' },
  { id: 'causal', label: 'Causal' },
  { id: 'multi-agent', label: 'Multi-agent' },
  { id: 'vision', label: 'Vision' },
];
const count = (id: string) =>
  [...publications, ...projects].filter((x: any) => x.topics?.includes(id)).length;

const updated = new Date().toLocaleDateString('en-CA', { month: 'long', year: 'numeric' });
const year = new Date().getFullYear();
const description = `${profile.name} — ${profile.role}.`;
const isMe = (a: string) => a === profile.name;
const pv = (key?: string) => (key && previews[key] ? { 'data-preview': key } : {});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://jqshang.github.io/" />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://jqshang.github.io${profile.photo}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..600&family=Gloock&family=Mea+Culpa&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved || 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <button class="theme" type="button" aria-label="Toggle dark mode">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle class="theme__sun" cx="12" cy="12" r="5" />
        <g class="theme__rays">
          {Array.from({ length: 8 }, (_, i) => (
            <line x1="12" y1="1.5" x2="12" y2="4" transform={`rotate(${i * 45} 12 12)`} />
          ))}
        </g>
      </svg>
    </button>

    <main id="main" class="col">
      <!-- Intro -->
      <header class="intro">
        <div class="intro__text">
          <h1>{profile.name}</h1>
          <p class="motto">
            <span lang="zh-CN" class="motto__zh">{profile.motto.zh}</span>
            <span lang="en" class="motto__en">{profile.motto.en}</span>
          </p>
          <ul class="links">
            {profile.links.map((l: any) => (
              <li>
                <a
                  class="icon-link"
                  href={l.url}
                  aria-label={l.label}
                  data-label={l.label}
                  {...(isMail(l.url) ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                  set:html={l.text ? `<span class="icon-link__text">${l.text}</span>` : icon(l.icon)}
                />
              </li>
            ))}
          </ul>
        </div>
        <img class="avatar" src={profile.photo} width="440" height="440" alt={`Photo of ${profile.name}`} />
      </header>

      <!-- About -->
      <section aria-labelledby="about-h" class="block">
        <h2 id="about-h">About</h2>
        {profile.bio.map((p: string) => <p class="prose" set:html={withPreviews(p)} />)}
      </section>

      <!-- Publications + projects share one filter. The bar is sticky across both and leaves after projects. -->
      <div class="filtered block" id="publications">
        <div class="filterbar" role="region" aria-label="Filter publications and projects by topic">
          <div class="chips" role="group" aria-label="Topic">
            <button type="button" class="chip" data-topic="all" aria-pressed="true">All</button>
            {TOPICS.map((t) => (
              <button type="button" class="chip" data-topic={t.id} aria-pressed="false">
                {t.label}<span class="chip__n">{count(t.id)}</span>
              </button>
            ))}
          </div>
          <p class="filterbar__status" aria-live="polite">
            <span class="filterbar__summary">Showing {publications.length} publications · {projects.length} projects</span>
            <button type="button" class="filterbar__clear" hidden>Clear</button>
          </p>
        </div>

        <section aria-labelledby="pub-h" class="sub">
          <h2 id="pub-h">Selected Publications</h2>
          {notes.publications && <p class="note" set:html={notes.publications} />}
          <ol class="pubs">
            {publications.map((p: any, i: number) => (
              <li class="pub filterable" data-kind="pub" data-topics={p.topics.join(' ')}>
                <div class="filterable__inner">
                  <button type="button" class="pub__head" aria-expanded="false" aria-controls={`pub-${i}`}>
                    <span class="pub__title">{p.title}</span>
                    <span class="pub__meta">
                      <span>{p.venue}</span>
                      {p.status && <span class={`badge ${p.status === 'Oral' ? 'badge--hot' : ''}`}>{p.status}</span>}
                    </span>
                    <span class="pub__authors">
                      {p.authors.map((a: string, k: number) => (
                        <>
                          {isMe(a) ? <strong>{a}</strong> : a}
                          {(p.first ?? [0]).includes(k) && <sup class="dagger" title="First author">†</sup>}
                          {k < p.authors.length - 1 ? ', ' : ''}
                        </>
                      ))}
                    </span>
                    <span class="pub__chev" aria-hidden="true" />
                  </button>
                  <div class="pub__panel" id={`pub-${i}`}>
                    <div class="pub__panel-inner">
                      <p class="pub__summary">{p.summary}</p>
                      {(p.links.length > 0 || p.bibtex) && (
                        <div class="pub__actions">
                          {p.links.map((l: any) => <a class="pill" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}<span class="arrow" aria-hidden="true"></span></a>)}
                          {p.bibtex && <button type="button" class="pill copy" data-copy={p.bibtex}>Copy BibTeX</button>}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>
          <p class="empty" hidden>No publications in this topic yet.</p>
        </section>

        <section aria-labelledby="proj-h" class="sub" id="projects">
          <h2 id="proj-h">Selected Projects</h2>
          <ul class="rows">
            {projects.map((p: any) => (
              <li class="row filterable" data-kind="proj" data-topics={p.topics.join(' ')}>
                <div class="filterable__inner row__grid">
                  <span class="row__when">{p.period}</span>
                  <div>
                    <p class="row__what">{p.title}</p>
                    <p class="row__note">{p.summary}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
          <p class="empty" hidden>No projects in this topic yet.</p>
        </section>
        <hr class="filtered__end" />
      </div>

      <!-- Experience -->
      <section aria-labelledby="res-h" class="block" id="research">
        <h2 id="res-h">Research</h2>
        <ul class="rows">
          {cv.research.map((r: any) => (
            <li class="row row__grid">
              <span class="row__when">{r.period}</span>
              <div>
                <p class="row__what">
                  {r.role}, <a class="pv" href={previews[r.preview]?.url} {...pv(r.preview)}>{r.org}</a>
                </p>
                <p class="row__note">{r.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="ind-h" class="block" id="industry">
        <h2 id="ind-h">Industry</h2>
        <ul class="rows">
          {cv.industry.map((r: any) => (
            <li class="row row__grid">
              <span class="row__when">{r.period}</span>
              <div>
                <p class="row__what">{r.role}, {r.url ? <a href={r.url}>{r.org}</a> : r.org}</p>
                <p class="row__note">{r.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="edu-h" class="block">
        <h2 id="edu-h">Education</h2>
        <ul class="rows">
          {cv.education.map((e: any) => (
            <li class="row row__grid">
              <span class="row__when">{e.period}</span>
              <div>
                <p class="row__what">{e.degree}, <a class="pv" href={previews[e.preview]?.url} {...pv(e.preview)}>{e.org}</a></p>
                <p class="row__note">{e.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="awd-h" class="block">
        <h2 id="awd-h">Awards</h2>
        <ul class="rows">
          {cv.awards.map((a: any) => (
            <li class="row row__grid row--tight">
              <span class="row__when">{a.year}</span>
              <p class="row__what row__what--split"><span>{a.name}</span><span class="amount">{a.amount}</span></p>
            </li>
          ))}
        </ul>
      </section>

      <!-- Off the clock -->
      <section aria-labelledby="otc-h" class="block" id="off-the-clock">
        <h2 id="otc-h">Off the clock</h2>
        <p class="prose">What's on repeat lately.</p>
        <ul class="shelf">
          {music.map((m: any) => (
            <li class="record" style={`--sleeve: ${m.color}`}>
              <a class="record__hit" href={m.url || undefined} tabindex="0" aria-label={`${m.title} by ${m.artist}`}>
                <span class="record__vinyl" aria-hidden="true">
                  <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="49" class="v-disc" />
                    {[44, 39, 34, 29].map((r) => <circle cx="50" cy="50" r={r} class="v-groove" />)}
                    <circle cx="50" cy="50" r="17" class="v-label" />
                    <circle cx="50" cy="50" r="2" class="v-hole" />
                    <path d="M50 36 a14 14 0 0 1 14 14" class="v-shine" />
                  </svg>
                </span>
                <span class="record__sleeve">
                  {m.cover ? <img src={m.cover} alt="" width="200" height="200" /> : <span class="record__art">{m.title}</span>}
                </span>
              </a>
              <p class="record__cap"><span>{m.title}</span><span>{m.artist}</span></p>
            </li>
          ))}
        </ul>
      </section>

      <footer class="foot">
        <p>© {year} {profile.name} · Updated {updated}</p>
        <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      </footer>
    </main>

    <!-- One shared hover card -->
    <div class="preview" role="tooltip" id="preview" hidden>
      <p class="preview__title"></p>
      <p class="preview__sub"></p>
      <p class="preview__body"></p>
      <p class="preview__url"></p>
    </div>
    <script type="application/json" id="preview-data" set:html={JSON.stringify(previews)} />

    <script>
      const root = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Theme: a circle wipe from the toggle ---- */
      const toggle = document.querySelector<HTMLButtonElement>('.theme')!;
      toggle.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const apply = () => { root.dataset.theme = next; localStorage.setItem('theme', next); };
        const doc = document as any;
        if (!doc.startViewTransition || reduce) return apply();
        const r = toggle.getBoundingClientRect();
        root.style.setProperty('--vt-x', `${r.left + r.width / 2}px`);
        root.style.setProperty('--vt-y', `${r.top + r.height / 2}px`);
        doc.startViewTransition(apply);
      });

      /* ---- Expandable papers ---- */
      document.querySelectorAll<HTMLButtonElement>('.pub__head').forEach((btn) => {
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          btn.closest('.pub')!.classList.toggle('is-open', !open);
        });
      });

      /* ---- Copy BibTeX ---- */
      document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
        const label = btn.textContent;
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(btn.dataset.copy ?? ''); btn.textContent = 'Copied ✓'; }
          catch { btn.textContent = 'Copy failed'; }
          btn.classList.add('is-done');
          setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 1600);
        });
      });

      /* ---- Topic filter (papers + projects) ---- */
      const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
      const items = [...document.querySelectorAll<HTMLElement>('.filterable')];
      const summary = document.querySelector<HTMLElement>('.filterbar__summary')!;
      const clear = document.querySelector<HTMLButtonElement>('.filterbar__clear')!;
      const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
      function applyFilter(t: string) {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.topic === t)));
        let pubs = 0, projs = 0;
        items.forEach((el) => {
          const show = t === 'all' || el.dataset.topics!.split(' ').includes(t);
          el.classList.toggle('is-out', !show);
          el.toggleAttribute('inert', !show);
          if (show) el.dataset.kind === 'pub' ? pubs++ : projs++;
        });
        document.querySelectorAll<HTMLElement>('.filtered .sub').forEach((sec) => {
          sec.querySelector<HTMLElement>('.empty')!.hidden = !!sec.querySelector('.filterable:not(.is-out)');
        });
        summary.textContent = `Showing ${plural(pubs, 'publication')} · ${plural(projs, 'project')}`;
        clear.hidden = t === 'all';
      }
      chips.forEach((chip) => chip.addEventListener('click', () => applyFilter(chip.dataset.topic!)));
      clear.addEventListener('click', () => applyFilter('all'));

      /* ---- Hover previews ---- */
      const data = JSON.parse(document.getElementById('preview-data')!.textContent!);
      const card = document.getElementById('preview')!;
      const q = (s: string) => card.querySelector<HTMLElement>(s)!;
      let showT: number | undefined, hideT: number | undefined;
      const canHover = matchMedia('(hover: hover)').matches;
      function show(el: HTMLElement) {
        const p = data[el.dataset.preview!];
        if (!p) return;
        q('.preview__title').textContent = p.title;
        q('.preview__sub').textContent = p.sub;
        q('.preview__body').textContent = p.body;
        q('.preview__url').textContent = new URL(p.url).host.replace(/^www\./, '');
        card.hidden = false;
        const r = el.getBoundingClientRect(), cw = card.offsetWidth, ch = card.offsetHeight;
        const x = Math.min(Math.max(12, r.left + r.width / 2 - cw / 2), innerWidth - cw - 12);
        let y = r.bottom + 10, below = true;
        if (y + ch > innerHeight - 12) { y = r.top - ch - 10; below = false; }
        card.style.left = `${x + scrollX}px`;
        card.style.top = `${y + scrollY}px`;
        card.style.transformOrigin = `${r.left + r.width / 2 - x}px ${below ? '0' : '100%'}`;
        el.setAttribute('aria-describedby', 'preview');
        requestAnimationFrame(() => card.classList.add('is-on'));
      }
      function hide(el?: HTMLElement) {
        card.classList.remove('is-on');
        el?.removeAttribute('aria-describedby');
        hideT = window.setTimeout(() => (card.hidden = true), 160);
      }
      document.querySelectorAll<HTMLElement>('[data-preview]').forEach((el) => {
        if (canHover) {
          el.addEventListener('pointerenter', () => { clearTimeout(hideT); showT = window.setTimeout(() => show(el), 220); });
          el.addEventListener('pointerleave', () => { clearTimeout(showT); hide(el); });
        }
        el.addEventListener('focus', () => { clearTimeout(hideT); show(el); });
        el.addEventListener('blur', () => hide(el));
      });
      addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });

      /* ---- Gentle entrances ---- */
      if (!reduce && 'IntersectionObserver' in window) {
        root.classList.add('motion');
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('.block, .intro').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
